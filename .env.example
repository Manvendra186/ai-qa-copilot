# AI QA Copilot — environment template (copy to .env)
# Build bible: §31.1 (LLM), §31.11 (execution)

# --- App (S0.3 FastAPI) ---
# QA_COPILOT_ENV=development
# QA_COPILOT_LOG_LEVEL=INFO

# --- LLM (local llama server, OpenAI-compatible — no cloud, §31.1) ---
LLM_BASE_URL=http://localhost:8080/v1
# Model id exactly as reported by GET {LLM_BASE_URL}/models.
# LM Studio example (Qwen3.8-27B Q4_K_M, n_ctx 100,096):
# LLM_MODEL=.\Models\lmstudio-community\Qwen3.8-27B-GGUF\Qwen3.8-27B-Q4_K_M.gguf
LLM_MODEL=your-local-model
# Optional per-agent model-class overrides (§31.1)
# LLM_MODEL_SMALL=
# LLM_MODEL_CODER=
# LLM_MODEL_VISION=

# --- AI tuning (token budgets / sampling / timeouts — qa_copilot_ai.config) ---
# Per-prompt front-matter (packages/ai/prompts/*.md) still wins when set;
# these are the shared fallbacks, read from the environment at call time.
# Max input tokens per call (hard cap — the call fails loud when exceeded).
# AI_MAX_INPUT_TOKENS=60000
# Max output tokens (max_tokens) when a prompt has no output_budget.
# AI_MAX_OUTPUT_TOKENS=40000
# Sampling temperature (0.0 = deterministic … 2.0 = creative).
# AI_TEMPERATURE=0.3
# Per-call timeout in seconds (local inference is slow by definition).
# AI_TIMEOUT_S=12000
# Connect timeout in seconds.
# AI_CONNECT_TIMEOUT_S=100
# Retries on transport errors.
# AI_MAX_RETRIES=1
# Extra chat-completions body fields (JSON object), merged into every model
# call. Needed to disable Qwen3 thinking on LM Studio / llama.cpp — thinking
# consumes 10k–30k+ output tokens and can starve the final answer.
# AI_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# --- Infrastructure (S0.2 docker-compose) ---
# Ports are overridable in `.env` via POSTGRES_PORT / REDIS_PORT (compose defaults:
# 5432 / 6379). If a local Postgres already holds 5432, set POSTGRES_PORT=5433
# and point DATABASE_URL at 5433.
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql+psycopg://qa:qa@localhost:5432/qa_copilot
REDIS_URL=redis://localhost:6379/0

# --- App under test (Playwright target, §31.11) ---
APP_UNDER_TEST=http://localhost:3000

# --- Auth (S0.8, §31.3: dev-mode single user + JWT) ---
# HS256 signing secret (16+ chars). Generate:
#   python -c "import secrets; print(secrets.token_hex(32))"
AUTH_TOKEN_SECRET=change-me-0123456789abcdef
# Dev user login password (email dev@local.dev — see scripts/seed.py).
AUTH_DEV_PASSWORD=dev-password
